# Plantilla de secretos — copiar a `.streamlit/secrets.toml` para correr local.
# En Streamlit Community Cloud NO se sube este archivo: los valores se pegan en
# Manage app > Settings > Secrets (mismo formato TOML).
#
# `.streamlit/secrets.toml` esta en .gitignore. Este .example si se versiona.

# --- GitHub (backend de datos actual) ---------------------------------------
# Token con permiso de lectura/escritura sobre el repo que guarda los JSON.
# La app lee y escribe via Contents API (ver _leer_json_github_raw / _guardar_json_github_raw).
GITHUB_TOKEN = ""

# --- Power BI (modulo Indicadores) ------------------------------------------
# URL del informe embebido. Si queda vacia, el modulo se muestra deshabilitado.
PBI_INDICADORES_URL = ""

# --- Boostr (busqueda de vehiculo por patente, modulo Cotizador) -------------
# Key gratuita de boostr.cl. Sin key el campo avisa y el catalogo sigue igual.
BOOSTR_API_KEY = ""

# --- Supabase: backend de app.py (API REST / PostgREST) ----------------------
# Con AMBOS valores cargados, los documentos de la lista blanca SUPABASE_DOCS
# (usuarios_curifor, notificaciones, audit_log, cuenta_ficha_revisados) se leen
# y escriben en Supabase en vez de GitHub. Si falta cualquiera de los dos, la
# capa queda inerte y todo sigue contra GitHub: publicar el codigo no rompe nada.
# La service_role saltea RLS -> NUNCA versionarla ni exponerla en el navegador.
SUPABASE_URL = "https://ordgsglujssgzmnlmcus.supabase.co"
SUPABASE_SERVICE_KEY = ""

# --- Supabase: dual-write del consolidador (conexion Postgres directa) -------
# Lo usa supabase_sync.py, que corre en el PC de la sucursal (no en la nube).
# Solo la password es secreta; el resto tiene defaults en supabase_sync.py.
SUPABASE_DB_PASSWORD = ""
# Opcionales, sobre-escriben los defaults del session pooler:
# SUPABASE_DB_HOST = "aws-0-us-east-1.pooler.supabase.com"
# SUPABASE_DB_USER = "postgres.ordgsglujssgzmnlmcus"
# SUPABASE_DB_PORT = "5432"
# SUPABASE_DB_NAME = "postgres"
